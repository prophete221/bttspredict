set ssl:verify no
set net:timeout 60
set net:max-retries 2
set cmd:fail-exit yes

# robots.txt et sitemap.xml sont sauvegardés ici. .htaccess n'est pas lu par RETR:
# il sera publié après l'upload principal par la méthode temporaire + rename.
get robots.txt -o out/predeploy-backups/robots.txt
get sitemap.xml -o out/predeploy-backups/sitemap.xml

# Le nouvel état sûr peut être absent au premier déploiement; le legacy reste
# une source de hachages seulement. Le helper choisit l'état sûr s'il est valide.
# Lectures d'état bornées : un 550 ou un serveur silencieux ne doit pas bloquer le préflight.
set net:timeout 10
set net:max-retries 1
set cmd:fail-exit no
# Le manifeste distant est la base complète du diff. L'inventaire Match-only
# ci-dessous ne doit jamais servir d'inventaire global pour calculer les uploads.
get deploy-manifest.json -o out/deploy-manifest.prev.json
get .ftp-deploy-sync-state-safe.json -o /tmp/ftp-action-state-safe.remote.json
get .ftp-deploy-sync-state.json -o /tmp/ftp-action-state-legacy.remote.json
set cmd:fail-exit yes
set net:timeout 60
set net:max-retries 2

# Arrêt explicite avant les listings/suppressions si aucun état distant valide n'existe.
!node scripts/validate-ftp-deploy-state.mjs --state-safe=/tmp/ftp-action-state-safe.remote.json --state-legacy=/tmp/ftp-action-state-legacy.remote.json

# Aucun listing récursif distant n'est utilisé pour inventer des chemins de suppression.
# Les candidats AR proviennent des 36 slugs connus et du manifeste de référence téléchargé;
# leur présence exacte sera testée après l'activation et la vérification du popup.
!node scripts/prepare-ftp-deploy-plan.mjs --state-safe=/tmp/ftp-action-state-safe.remote.json --state-legacy=/tmp/ftp-action-state-legacy.remote.json --out-dir=out --public-dir=public --state-seed=/tmp/ftp-action-state-seed.json
put /tmp/ftp-action-state-seed.json -o .ftp-deploy-sync-state-safe.json
bye
