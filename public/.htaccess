# ─── Redirection HTTP vers HTTPS (301) ───
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── Redirection www vers non-www ───
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ─── Routing HTML statique ───
DirectorySlash Off
RewriteRule \.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)/?$ /$1.html [L]

# ─── Redirect 301: /linebet-promo-code → /code-promo-linebet-senegal ───
# Anti-doublon SEO : /linebet-promo-code est un doublon de /code-promo-linebet-senegal.
# Redirection permanente 301 pour transférer le link equity et éliminer le duplicate content.
RewriteRule ^linebet-promo-code/?$ /code-promo-linebet-senegal [R=301,L]

# ─── Redirect 301: pages doorway supprimées en v64 → / (homepage) ───
# Plateforme PRO : passage de 51 pages blog 2000 à ~18 pages plateforme type Flashscore.
# Les anciennes doorway pages (templates identiques) sont supprimées du code mais
# conservent une redirection 301 Apache pour transférer le link equity éventuel
# vers la homepage qui contient désormais les pronostics du jour.
RewriteRule ^betting-tips/?$ / [R=301,L]
RewriteRule ^bookmakers/?$ / [R=301,L]
RewriteRule ^correct-score-predictions/?$ / [R=301,L]
RewriteRule ^football-predictions-today/?$ / [R=301,L]
RewriteRule ^league-predictions/?$ / [R=301,L]
RewriteRule ^match-predictions/?$ / [R=301,L]
RewriteRule ^over-2-5-predictions/?$ / [R=301,L]
RewriteRule ^team-predictions/?$ / [R=301,L]
RewriteRule ^pronostics/?$ / [R=301,L]
RewriteRule ^pronostics/aujourd-hui/?$ / [R=301,L]
RewriteRule ^prediction-aviator/?$ / [R=301,L]
RewriteRule ^faille-fifa/?$ / [R=301,L]
RewriteRule ^blog/?$ / [R=301,L]
RewriteRule ^blog/(.+)?$ / [R=301,L]
RewriteRule ^presse/?$ / [R=301,L]
RewriteRule ^equipe/?$ / [R=301,L]
RewriteRule ^over-2-5/?$ / [R=301,L]
RewriteRule ^over-2-5/(.+)?$ / [R=301,L]

# ─── 404 spécifique pour /match/[slug] non généré ───
# Les pages match sont pré-générées en SSG dans out/match/[slug]/index.html.
# Si le fichier n'existe pas (match non dans la liste du jour), on renvoie 404.html
# au lieu de servir la homepage via la fallback index.html (qui masquait le 404).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^match/.+/?$ /404.html [L,R=404]

# ─── Fallback générique (toutes les URLs non matchées) ───
# Pour le routing côté client Next.js (pages dynamiques autres que /match/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ─── En-tête HSTS (Strict Transport Security) ───
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

# ─── En-têtes de sécurité ───
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# ─── Cache navigateur ───
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
ExpiresByType application/json "access plus 1 hour"
ExpiresByType text/html "access plus 5 minutes"

# ─── Erreur 404 personnalisée ───
ErrorDocument 404 /404.html

# ─── Compression Gzip ───
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
