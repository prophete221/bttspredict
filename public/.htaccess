# ─── Redirection HTTP vers HTTPS (301) ───
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── Redirection www vers non-www ───
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ─── Routing HTML statique ───
DirectorySlash Off
DirectoryIndex index.html
Options -Indexes
RewriteRule \.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)/?$ /$1.html [L]

# ─── Redirect 301: /linebet-promo-code → /code-promo-linebet-senegal ───
# Anti-doublon SEO : /linebet-promo-code est un doublon de /code-promo-linebet-senegal.
# Redirection permanente 301 pour transférer le link equity et éliminer le duplicate content.
RewriteRule ^linebet-promo-code/?$ /code-promo-linebet-senegal [R=301,L]

# ─── Redirects 301: anciennes doorway pages supprimées en v64 → / ───
# /pronostics est désormais une route officielle alias des pronostics du jour.
RewriteRule ^betting-tips/?$ / [R=301,L]
RewriteRule ^bookmakers/?$ / [R=301,L]
RewriteRule ^correct-score-predictions/?$ / [R=301,L]
RewriteRule ^football-predictions-today/?$ / [R=301,L]
RewriteRule ^league-predictions/?$ / [R=301,L]
RewriteRule ^match-predictions/?$ / [R=301,L]
RewriteRule ^over-2-5-predictions/?$ / [R=301,L]
RewriteRule ^team-predictions/?$ / [R=301,L]
RewriteRule ^pronostics/aujourd-hui/?$ /pronostics [R=301,L]
RewriteRule ^prediction-aviator/?$ / [R=301,L]
RewriteRule ^faille-fifa/?$ / [R=301,L]
RewriteRule ^blog/?$ / [R=301,L]
RewriteRule ^blog/(.+)?$ / [R=301,L]
RewriteRule ^presse/?$ / [R=301,L]
RewriteRule ^equipe/?$ / [R=301,L]
RewriteRule ^over-2-5/?$ / [R=301,L]
RewriteRule ^over-2-5/(.+)?$ / [R=301,L]

# ─── 404 spécifique pour /match/[slug] non généré ───
# Les pages match sont pré-générées en SSG dans out/match/[slug]/index.html.
# Si le fichier n'existe pas (match non dans la liste du jour), on renvoie 404.html
# au lieu de servir la homepage via la fallback index.html (qui masquait le 404).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^match/.+/?$ /404.html [L,R=404]

# ─── Fallback générique (toutes les URLs non matchées) ───
# CORRECTION 1+2: Retourner 404 au lieu de servir index.html (soft 404 fix)
# Exception: la racine / doit toujours servir index.html
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /404.html [L,R=404]

# ─── Encodage UTF-8 des réponses texte et HTML statiques ───
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt

# ─── En-tête HSTS (Strict Transport Security) ───
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

# ─── En-têtes de sécurité ───
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# CORRECTION 8: Content-Security-Policy + Permissions-Policy
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://a.espncdn.com data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# CORRECTION 9: X-XSS-Protection retiré (déconseillé par OWASP)
# (anciennement: Header always set X-XSS-Protection "1; mode=block" — supprimé)

# ─── Cache navigateur ───
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
ExpiresByType application/json "access plus 1 hour"
# Les pages HTML statiques doivent refléter immédiatement chaque déploiement.
# Les assets versionnés restent fortement cacheables séparément.
ExpiresByType text/html "access plus 0 seconds"
<FilesMatch "\.(html|htm)$">
  Header always set Cache-Control "no-cache, no-store, must-revalidate"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
</FilesMatch>

# ─── Erreur 404 personnalisée ───
ErrorDocument 404 /404.html

# ─── Compression Gzip ───
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
