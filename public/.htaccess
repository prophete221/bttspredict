# ─── Redirection HTTP vers HTTPS (301) ───
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── Redirection www vers non-www ───
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ─── Routing HTML statique ───
DirectorySlash Off

# 1. Servir les fichiers .html directement
RewriteRule \.html$ - [L]

# 2. Si le fichier existe physiquement → le servir
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. Si le dossier existe physiquement → le servir
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Si /chemin.html existe → servir /chemin.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ /$1.html [L]

# 5. Fallback final vers index.html (SPA routing)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule . /index.html [L]

# ─── En-têtes de sécurité ───
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# ─── Cache navigateur ───
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
ExpiresByType application/json "access plus 1 hour"
ExpiresByType text/html "access plus 5 minutes"

# ─── Erreur 404 ───
ErrorDocument 404 /404.html
